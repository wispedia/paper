FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-writer libreoffice-math poppler-utils fonts-noto-cjk fonts-stix \
    python3 python3-pil fontconfig
# Put the verified official LibreOffice RPM installation in the build context.
COPY libreoffice26.8 /opt/libreoffice26.8
COPY preview.py /opt/paper/preview.py
COPY fonts.conf /etc/paper/fonts.conf
ENV PAPER_SOFFICE_BIN=/opt/libreoffice26.8/program/soffice \
    FONTCONFIG_FILE=/etc/paper/fonts.conf HOME=/tmp
ENTRYPOINT ["python3", "/opt/paper/preview.py", "/work"]
