[Unit]
Description=Paper HTTPS gateway
After=network-online.target
Wants=network-online.target

[Service]
User=caddy
Group=caddy
Environment=HTTP_PROXY=http://127.0.0.1:17898
Environment=HTTPS_PROXY=http://127.0.0.1:17898
Environment=NO_PROXY=localhost,127.0.0.1
ExecStart=/usr/local/bin/caddy run --config /etc/paper/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/paper/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/caddy
MemoryMax=180M

[Install]
WantedBy=multi-user.target
